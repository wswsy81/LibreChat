# 未来线 · 生产环境变量模板
# 用法:cp deploy/.env.prod.example .env  然后:
#   1) 填 DOMAIN / POLARIS_KEY(下面标 <<< 改我 的行)
#   2) 跑 bash deploy/gen-secrets.sh 生成随机密钥,把输出粘到本文件对应行
#   3) chmod 600 .env
# 绝不提交本文件的真实副本(.env 已在 .gitignore)。

# ===== 域名 / 入口 =====
DOMAIN=yiweilife.com                     # 已定:A 记录须指向 150.109.253.173
DOMAIN_CLIENT=https://yiweilife.com
DOMAIN_SERVER=https://yiweilife.com
HOST=0.0.0.0
PORT=3080

# ===== 数据库(容器内网,勿改服务名 mongodb)=====
MONGO_URI=mongodb://mongodb:27017/LibreChat
MONGO_ROOT_PASSWORD=                     # gen-secrets.sh 生成
MONGO_APP_PASSWORD=                      # gen-secrets.sh 生成

# ===== 模型层(复用宿主 new-api)=====
POLARIS_KEY=sk-xxxx                       # <<< 改我:new-api 的 key(同开发机那把,或 new-api 控制台取)

# ===== 引擎内部鉴权(api <-> shim)=====
FUTURE_ENGINE_INTERNAL_TOKEN=            # gen-secrets.sh 生成
FUTURE_ENGINE_IDENTITY_SECRET=           # gen-secrets.sh 生成

# ===== 手机本地数据 beta（默认关闭）=====
# 只把明确测试账号加入白名单；ID/邮箱均为逗号分隔。
FUTURE_LINES_LOCAL_DATA_BETA_ENABLED=false
FUTURE_LINES_LOCAL_DATA_BETA_USER_IDS=
FUTURE_LINES_LOCAL_DATA_BETA_EMAILS=

# ===== 加密 / 会话密钥(务必用 gen-secrets.sh 生成,勿复用开发机)=====
CREDS_KEY=                                # gen-secrets.sh 生成(32字节hex)
CREDS_IV=                                 # gen-secrets.sh 生成(16字节hex)
JWT_SECRET=                               # gen-secrets.sh 生成
JWT_REFRESH_SECRET=                       # gen-secrets.sh 生成

# ===== 产品外观 =====
APP_TITLE=未来线
CUSTOM_FOOTER=未来线 · 不替你决定 · 你的存档只属于你

# ===== 注册策略(邀请制:关公开注册,用原生 invite 一人一链)=====
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true

# ===== 搜索(不跑 meilisearch,关掉)=====
SEARCH=false
MEILI_MASTER_KEY=                         # SEARCH=false 时用不到,留空即可

# ===== 配置文件路径(容器内)=====
CONFIG_PATH=/app/librechat.yaml

# ===== Reveal Arc 逐账号灰度（默认双关）=====
REVEAL_ARC_ENABLED=0
REVEAL_ARC_PILOT_USER_IDS=                    # 逗号分隔可信用户 ID；留空时即使总开关=1也不开放

# ===== 产品分析 Umami =====
ANALYTICS_DOMAIN=analytics.yiweilife.com     # A 记录须指向 150.109.253.173
UMAMI_DB_PASSWORD=                            # gen-secrets.sh 生成
UMAMI_APP_SECRET=                             # gen-secrets.sh 生成
