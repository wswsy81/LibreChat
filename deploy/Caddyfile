# 未来线 · Caddy 反代 + 自动 HTTPS
# {$DOMAIN} 来自 compose 注入的环境变量(= .env 里的 DOMAIN)
# Caddy 自动向 Let's Encrypt 申请/续期证书,零配置。

{$DOMAIN} {
	encode zstd gzip

	# 人生设计室产品壳不允许被第三方站点嵌入。报告、地图、人物志 HTML
	# 是同源 iframe 制品，走下面的最小 SAMEORIGIN 例外。
	@embeddedLifeHtml {
		path /api/life/dossier/html /api/life/map/html /api/life/reports/*/html /api/life/reports/*/print /api/life/reports/*/print.html
	}
	@productSurface {
		not path /api/life/dossier/html /api/life/map/html /api/life/reports/*/html /api/life/reports/*/print /api/life/reports/*/print.html
	}

	# 反代到内网 api 容器;SSE 流式、WebSocket、文件上传 Caddy 默认透传
	reverse_proxy api:3080 {
		# 大文件上传不设上限(LibreChat 图片/文档上传)
		flush_interval -1
	}

	# 基本安全响应头
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), payment=(), usb=()"
		-Server
	}

	header @productSurface {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.yiweilife.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://analytics.yiweilife.com wss://{$DOMAIN}; media-src 'self' blob:; frame-src 'self' data: blob: https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Frame-Options "DENY"
	}

	header @embeddedLifeHtml {
		X-Frame-Options "SAMEORIGIN"
	}
}

# 产品分析 Umami:独立子域,自动 HTTPS,内网反代到 umami:3000
{$ANALYTICS_DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# 裸 HTTP 自动 301 到 HTTPS(Caddy 默认行为,无需额外配置)
